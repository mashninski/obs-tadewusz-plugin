{
  "name": "obs-tadewusz-plugin",
  "version": "1.0.0",
  "private": true,
  "description": "Плагін для OBS і Twitch: галасаванне за балы канала, бягучы радок і музыка па замовах гледачоў.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.19.0"
  },
  "scripts": {
    "start": "node core/main.js --verbose",
    "dev": "vite --config web/vite.config.ts",
    "build": "tsc -p web/tsconfig.json --noEmit && vite build --config web/vite.config.ts",
    "test": "node --test \"tests/**/*.test.js\" && vitest run --config web/vite.config.ts",
    "test:core": "node --test \"tests/**/*.test.js\"",
    "test:web": "vitest run --config web/vite.config.ts",
    "install-app": "node scripts/install.mjs"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
